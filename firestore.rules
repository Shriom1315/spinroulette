rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Admin Config Rules ---
    // config/admin stores { adminEmail: string }
    match /config/admin {
      // Anyone signed in can read (needed to do the email→uid check on the client)
      allow read: if isSignedIn();

      // First-time create: allowed by any signed-in user (no doc exists yet)
      allow create: if isSignedIn()
        && incoming().adminEmail is string
        && incoming().adminEmail.size() > 0
        && incoming().adminEmail.size() <= 256;

      // Update: only the current admin (email matches) can change it
      allow update: if isSignedIn()
        && request.auth.token.email == existing().adminEmail
        && incoming().adminEmail is string
        && incoming().adminEmail.size() > 0
        && incoming().adminEmail.size() <= 256;
    }

    // --- Session Rules ---
    match /sessions/{sessionId} {
      
      function isValidSession(data) {
        return data.adminId is string && data.adminId.size() <= 128
          && data.names is list
          && data.pitchedMembers is list
          && (data.currentWinner == null || data.currentWinner is string)
          && (data.stopwatchActive is bool)
          && (data.stopwatchEndTime is number);
      }

      allow read: if isSignedIn();
      
      allow create: if isSignedIn() 
        && isValidSession(incoming())
        && incoming().adminId == request.auth.uid;

      // Allow update if:
      //   a) The existing adminId matches the requester (normal case), OR
      //   b) The requester's email matches the config/admin adminEmail (admin uid rotation)
      allow update: if isSignedIn()
        && isValidSession(incoming())
        && (
          (existing().adminId == request.auth.uid && incoming().adminId == existing().adminId)
          ||
          (request.auth.token.email == get(/databases/$(database)/documents/config/admin).data.adminEmail
            && incoming().adminId == request.auth.uid)
        );
        
      allow delete: if isSignedIn() && existing().adminId == request.auth.uid;
      
      // --- Vote Rules ---
      match /votes/{voteId} {
        function isValidVote(data) {
          return data.choice in ['buy', 'leave']
            && data.userId == request.auth.uid
            && data.winnerName is string
            && data.timestamp is number;
        }

        allow read: if isSignedIn();
        
        allow create: if isSignedIn()
          && isValidVote(incoming())
          && voteId == (request.auth.uid + "_" + incoming().winnerName)
          // Cross-session validation: Must be voting for the current winner
          && get(/databases/$(database)/documents/sessions/$(sessionId)).data.currentWinner == incoming().winnerName
          && get(/databases/$(database)/documents/sessions/$(sessionId)).data.stopwatchActive == true;
          
        // Votes are locked (immutable)
        allow update, delete: if false;
      }
    }
  }
}
